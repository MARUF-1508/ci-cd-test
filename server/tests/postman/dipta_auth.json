		{
			"name": "register_user",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(",
							"    \"Register status should be 201\",",
							"    function()",
							"    {",
							"        pm.response.to.have.status(201);",
							"    }",
							");",
							"",
							"",
							"let response = pm.response.json();",
							"",
							"",
							"pm.test(",
							"    \"Response should contain user\",",
							"    function()",
							"    {",
							"        pm.expect(response)",
							"        .to.have.property(\"user\");",
							"    }",
							");",
							"",
							"",
							"pm.test(",
							"    \"Username should match\",",
							"    function()",
							"    {",
							"        pm.expect(response.user.username)",
							"        .to.eql(\"dipta\");",
							"    }",
							");",
							"",
							"",
							"pm.test(",
							"    \"Email should match\",",
							"    function()",
							"    {",
							"        pm.expect(response.user.email)",
							"        .to.eql(\"dipta@test.com\");",
							"    }",
							");"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
